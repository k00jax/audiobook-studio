# Shared secret for folder watcher ingest API (generate a long random string)
INGEST_API_KEY=

# TTS: edge (free, default) | openai | piper (local)
TTS_PROVIDER=edge

# OpenAI TTS (when TTS_PROVIDER=openai)
OPENAI_API_KEY=
TTS_VOICE=nova

# Piper TTS (when TTS_PROVIDER=piper) — run: npm run setup:piper
# PIPER_PYTHON=python
# PIPER_VOICE=en_US-lessac-medium
# PIPER_DATA_DIR=tools/piper/voices

# Edge TTS (when TTS_PROVIDER=edge) — run: npm run setup:edge
# EDGE_PYTHON=python
EDGE_VOICE=en-US-AndrewNeural

# How many chapters/parts to synthesize at once (1–8, default 3)
# TTS_PARALLEL_JOBS=3

# Splitting (no heading detection — delimiter line only)
SECTION_DELIMITER=---
PART_BUDGET_SECONDS=86400
WORDS_PER_MINUTE=150
DEFAULT_BOOK_TITLE=My Book

# Library root — each subfolder is a book/project (prefer OneDrive/Google Drive)
# Run: npm run scaffold:library -- "C:\Users\You\OneDrive\My Audiobooks"
WATCH_FOLDER=

WEB_APP_URL=http://127.0.0.1:3001

# Local SQLite library (default: data/library.db under repo)
# LIBRARY_DB_PATH=data/library.db
